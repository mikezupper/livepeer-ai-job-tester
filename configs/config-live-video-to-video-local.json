    "targetFPS": 12,
    "maxInitialLatencySeconds": 10,
    "orchMapping": {
      "0xdef1c70578b2b5e8589a42e26980687fc5153079": [
        "https://stream2.speedybird.xyz:18938"
      ]
    }
  },
  "pipelines": [
    {
      "name": "Live video to video manual local test",
      "uri": "live-video-to-video",
      "live": true,
      "promptVariants": [
        {
          "id": "manual-watercolor-low",
          "complexity": "low",
          "parameters": {
            "prompt": "watercolor painting style"
          }
        },
        {
          "id": "cyberpunk-medium",
          "complexity": "medium",
          "parameters": {
            "prompt": "a cinematic cyberpunk street with neon reflections and rainy atmosphere"
          }
        },
        {
